{
	"manifest_version": 3,
	"name": "CrapNote Web Clipper",
	"version": "0.1.0",
	"description": "Save links and clip selections or images to CrapNote (and optionally Readeck).",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Save to CrapNote"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"permissions": ["storage", "activeTab", "contextMenus", "scripting"],
	"host_permissions": ["http://*/*", "https://*/*"]
}
