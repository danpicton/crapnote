      "params": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "Note ID."
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "notes_reorder_pins",
      "method": "PUT",
