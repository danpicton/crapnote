{
  "version": 1,
  "operations": [
    {
      "name": "health",
      "method": "GET",
      "path": "/api/health",
      "scope": "public",
      "admin_only": false,
      "cookie_only": false,
      "description": "Health check.",
      "request": "json",
      "response": "json"
    },
    {
      "name": "theme_get",
      "method": "GET",
      "path": "/api/theme",
      "scope": "public",
      "admin_only": false,
      "cookie_only": false,
      "description": "Get the global theme (public so the login screen can render it).",
      "request": "json",
      "response": "json"
    },
    {
      "name": "auth_login",
      "method": "POST",
      "path": "/api/auth/login",
      "scope": "public",
      "admin_only": false,
      "cookie_only": false,
      "login_rate_limited": true,
      "description": "Log in with username and password; sets a session cookie.",
      "params": [
        {
          "name": "username",
          "in": "body",
          "type": "string",
          "required": true,
          "description": ""
        },
        {
          "name": "password",
          "in": "body",
          "type": "string",
          "required": true,
          "description": ""
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "setup_get",
      "method": "GET",
      "path": "/api/setup/{token}",
      "scope": "public",
      "admin_only": false,
      "cookie_only": false,
      "login_rate_limited": true,
      "description": "Look up a pending account-setup invite by its token.",
      "params": [
        {
          "name": "token",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Setup invite token."
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "setup_complete",
      "method": "POST",
      "path": "/api/setup/{token}",
      "scope": "public",
      "admin_only": false,
      "cookie_only": false,
      "login_rate_limited": true,
      "description": "Complete account setup by choosing a password.",
      "params": [
        {
          "name": "token",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Setup invite token."
        },
        {
          "name": "password",
          "in": "body",
          "type": "string",
          "required": true,
          "description": ""
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "auth_logout",
      "method": "POST",
      "path": "/api/auth/logout",
      "scope": "read",
      "admin_only": false,
      "cookie_only": false,
      "description": "End the current browser session.",
      "request": "json",
      "response": "none",
      "mcp_waived": "logout ends a cookie session; bearer tokens have no session to end"
    },
    {
      "name": "auth_me",
      "method": "GET",
      "path": "/api/auth/me",
      "scope": "read",
      "admin_only": false,
      "cookie_only": false,
      "description": "Return the authenticated user (id, username, admin flag).",
      "request": "json",
      "response": "json"
    },
    {
      "name": "auth_change_password",
      "method": "POST",
      "path": "/api/auth/password",
      "scope": "read",
      "admin_only": false,
      "cookie_only": true,
      "description": "Change your own password (cookie sessions only — a leaked token must not hijack the account).",
      "params": [
        {
          "name": "new_password",
          "in": "body",
          "type": "string",
          "required": true,
          "description": ""
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "tokens_list",
      "method": "GET",
      "path": "/api/tokens",
      "scope": "read",
      "admin_only": false,
      "cookie_only": false,
      "description": "List your API tokens (metadata only, never raw secrets).",
      "request": "json",
      "response": "json"
    },
    {
      "name": "tokens_create",
      "method": "POST",
      "path": "/api/tokens",
      "scope": "write",
      "admin_only": false,
      "cookie_only": true,
      "description": "Create an API token (cookie sessions only — tokens cannot mint tokens).",
      "params": [
        {
          "name": "name",
          "in": "body",
          "type": "string",
          "required": true,
          "description": ""
        },
        {
          "name": "scope",
          "in": "body",
          "type": "string",
          "required": true,
          "description": "\"read\" or \"read_write\"."
        },
        {
          "name": "ttl_days",
          "in": "body",
          "type": "integer",
          "required": false,
          "description": "Days until expiry; 0/omitted = default (90), -1 = no expiry."
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "tokens_revoke",
      "method": "DELETE",
      "path": "/api/tokens/{id}",
      "scope": "write",
      "admin_only": false,
      "cookie_only": false,
      "description": "Revoke one of your API tokens.",
      "params": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "Token ID."
        }
      ],
      "request": "json",
      "response": "none",
      "destructive": true
    },
    {
      "name": "tokens_revoke_all",
      "method": "POST",
      "path": "/api/tokens/revoke-all",
      "scope": "write",
      "admin_only": false,
      "cookie_only": false,
      "description": "Revoke all of your API tokens. Irreversible; this also revokes the token making the call.",
      "request": "json",
      "response": "none",
      "destructive": true
    },
    {
      "name": "notes_list",
      "method": "GET",
      "path": "/api/notes",
      "scope": "read",
      "admin_only": false,
      "cookie_only": false,
      "description": "List your notes, optionally filtered. Use the search param for full-text (FTS5) search.",
      "params": [
        {
          "name": "starred",
          "in": "query",
          "type": "boolean",
          "required": false,
          "description": "Filter by starred flag: true returns only starred notes, false only unstarred. Omit for all notes."
        },
        {
          "name": "tag",
          "in": "query",
          "type": "integer",
          "required": false,
          "description": "Only notes carrying this tag ID. Omit, or pass 0, for notes with any or no tag."
        },
        {
          "name": "search",
          "in": "query",
          "type": "string",
          "required": false,
          "description": "Full-text search query."
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "required": false,
          "description": "Max results per page (default 50, max 100)."
        },
        {
          "name": "offset",
          "in": "query",
          "type": "integer",
          "required": false,
          "description": "Number of results to skip."
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "notes_create",
      "method": "POST",
      "path": "/api/notes",
      "scope": "write",
      "admin_only": false,
      "cookie_only": false,
      "description": "Create a note (markdown body).",
      "params": [
        {
          "name": "title",
          "in": "body",
          "type": "string",
          "required": true,
          "description": "Title, max 500 chars."
        },
        {
          "name": "body",
          "in": "body",
          "type": "string",
          "required": false,
          "description": "Markdown body, max 500k chars."
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "notes_get",
      "method": "GET",
      "path": "/api/notes/{id}",
      "scope": "read",
      "admin_only": false,
      "cookie_only": false,
      "description": "Fetch a single note.",
      "params": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "Note ID."
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "notes_update",
      "method": "PUT",
      "path": "/api/notes/{id}",
      "scope": "write",
      "admin_only": false,
      "cookie_only": false,
      "description": "Update a note's title and/or body. Omitted fields are left unchanged. Fails with 423 if the note is locked.",
      "params": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "Note ID."
        },
        {
          "name": "title",
          "in": "body",
          "type": "string",
          "required": false,
          "description": "New title, max 500 chars."
        },
        {
          "name": "body",
          "in": "body",
          "type": "string",
          "required": false,
          "description": "New markdown body, max 500k chars."
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "notes_delete",
      "method": "DELETE",
      "path": "/api/notes/{id}",
      "scope": "write",
      "admin_only": false,
      "cookie_only": false,
      "description": "Move a note to the trash (recoverable for 7 days). Fails with 423 if locked.",
      "params": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "Note ID."
        }
      ],
      "request": "json",
      "response": "none"
    },
    {
      "name": "notes_toggle_star",
      "method": "PATCH",
      "path": "/api/notes/{id}/star",
      "scope": "write",
      "admin_only": false,
      "cookie_only": false,
      "description": "Toggle a note's starred flag; returns the updated note.",
      "params": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "Note ID."
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "notes_toggle_pin",
      "method": "PATCH",
      "path": "/api/notes/{id}/pin",
      "scope": "write",
      "admin_only": false,
      "cookie_only": false,
      "description": "Toggle a note's pinned flag; returns the updated note.",
      "params": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "Note ID."
        }
      ],
      "request": "json",
      "response": "json"
    },
    {
      "name": "notes_toggle_lock",
